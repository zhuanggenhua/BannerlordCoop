{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coop coordinator task handoff",
  "type": "object",
  "required": ["taskId", "baseCommit", "commit", "summary", "changedFiles", "tests", "evidence", "risks"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "summary": { "type": "string", "minLength": 1 },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "exitCode", "log", "sha256"],
        "properties": {
          "command": { "type": "string" },
          "exitCode": { "type": "integer" },
          "log": { "type": "string", "description": "Path to the actual test log file." },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "evidence": { "type": "array", "description": "Paths to existing evidence files. Prose and directories belong in risks or the summary.", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } }
  }
}
