<Project>
  <PropertyGroup>
    <!-- Bannerlord requires a dotted numeric module version. This also seeds the exact build label
         advertised through Steam; the SDK may append source-revision metadata to that label. -->
    <CoopVersion>0.1.7</CoopVersion>
  </PropertyGroup>
  <!-- Keep builds working when the host lacks the .NET Framework 4.7.2 developer targeting pack. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) Or !Exists('$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2\mscorlib.dll')">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
